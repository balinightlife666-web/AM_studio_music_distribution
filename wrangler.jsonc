{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "am-studio-distribution",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-09-14",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "distribution.nadmo.id",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./web/site",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS_BUCKET",
      "bucket_name": "am-studio-distribution-assets"
    }
  ]
}

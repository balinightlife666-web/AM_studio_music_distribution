{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "am-studio-music-distribution",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-09-14",
  "workers_dev": true,
  "vars": {
    "ASSETS_BUCKET": "DISABLED_D1_STORAGE"
  },
  "assets": {
    "directory": "./web/site",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "migrations_dir": "cloudflare/migrations"
    }
  ]
}

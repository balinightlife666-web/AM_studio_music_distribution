{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "am-studio-music-distribution",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-09-14",
  "workers_dev": true,
  "assets": {
    "directory": "./web/site",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "f5beb5b3-ca36-439a-86c7-9f73515b84eb"
    }
  ]
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "am-studio-music-distribution",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-09-14",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "musicdistribution.nadmo.id",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./web/site",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "6f71c86d-61f3-4bb8-86da-da68d16201da"
    }
  ]
}
